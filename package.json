{
  "name": "@xubylele/schema-forge",
  "version": "1.12.2",
  "description": "Universal migration generator from schema DSL",
  "main": "dist/cli.js",
  "type": "commonjs",
  "bin": {
    "schema-forge": "dist/cli.js"
  },
  "exports": {
    ".": {
      "require": "./dist/cli.js",
      "types": "./dist/cli.d.ts"
    },
    "./api": {
      "require": "./dist/api.js",
      "types": "./dist/api.d.ts"
    }
  },
  "scripts": {
    "build": "tsup src/cli.ts src/api.ts --format cjs --dts",
    "dev": "ts-node src/cli.ts",
    "test": "vitest",
    "test:integration:drift": "vitest run test/drift-realdb.integration.test.ts",
    "prepublishOnly": "npm run build",
    "publish:public": "npm publish --access public",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "keywords": [
    "cli",
    "schema",
    "sql",
    "generator",
    "migration",
    "database"
  ],
  "author": "Xuby",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xubylele/schema-forge.git"
  },
  "bugs": "https://github.com/xubylele/schema-forge/issues",
  "homepage": "https://schemaforge.xuby.cl/",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "pg": "^8.19.0",
    "update-notifier": "^7.3.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@types/node": "^25.2.3",
    "@types/pg": "^8.18.0",
    "@xubylele/schema-forge-core": "^1.5.0",
    "testcontainers": "^11.8.1",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
